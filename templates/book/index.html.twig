{% extends 'base.html.twig' %}

{% block title %}Главная{% endblock %}

{% block body %}
<table class="table">
    <thead>
        <tr>
            <th csope="col">Title</th>
            <th csope="col">Author</th>
            <th csope="col">Status</th>
            <th csope="col">Rating</th>
            <th csope="col">Genre</th>
            <th csope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.title }}</td>
                <td>{{ book.author }}</td>
                <td>{{ book.status }}</td>
                <td>{{ book.rating }}</td>
                <td>
                    {% for genre in book.genres %}
                        <span class="badge bg-secondary">{{ genre.name }}</span>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('Upd_book', {'id':book.id}) }}" class="btn btn-primary">Изменить</a>
                    <form action="{{ path('Del_book', {'id':book.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('my-token-id') }}">
                        <button class="btn btn-danger">Удалить</button>
                    </form>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
    <div class="navigation">
        {{ knp_pagination_render(books) }}
    </div>
    <a href="{{ path('Add_book') }}" class="btn btn-info">Добавить книгу</a>
{% endblock %}
